# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (matches deploy/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=perimeter_db
POSTGRES_USER=perimeter
POSTGRES_PASSWORD=change_me_db_password

# BFF auth and database (used by services/bff-server)
DATABASE_URL=postgres://perimeter:change_me_db_password@localhost:5432/perimeter_db
# Signing key for session tokens. Use a long random string; never commit the real value.
AUTH_SECRET=change_me_to_a_long_random_string
# Shared secret Alertmanager sends as `Authorization: Bearer <secret>` to the alert webhook.
WEBHOOK_SECRET=change_me_to_another_long_random_string

# Browser origins allowed to call the BFF (comma separated). Default: the Vite dev server.
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the BFF (0 if none). Needed for per-client rate limits behind an ingress.
TRUST_PROXY=0

# Services
BFF_PORT=3001
CORRELATION_ENGINE_PORT=8000
CORRELATION_URL=http://localhost:8000

# LLM root-cause draft (Groq free tier; create a key at https://console.groq.com). The engine uses it to draft a root-cause report for each incident; without it incidents are still stored, with no draft.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model (default openai/gpt-oss-120b).
# PERIMETER_LLM_MODEL=openai/gpt-oss-20b

# Telegram on-call bot (placeholders; not used until the router is built)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here
